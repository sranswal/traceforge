# ============================================================================
# TraceForge - Environment Configuration Template
# Never commit your real .env file. Copy this file to .env for local setup.
# ============================================================================

# --- Google Gemini Configuration ---
# Mandatory for AI Architecture Summaries and Ask Codebase Q&A
GEMINI_API_KEY=

# Optional: Secondary and tertiary Gemini API keys for automatic auth/key failover
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# Optional: Ordered Gemini model failover chain (comma-separated, primary -> secondary -> tertiary)
# Defaults to: gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite
# GEMINI_MODEL_CHAIN=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite

# Optional: Single primary model override (prepended to the failover chain if set)
# GEMINI_MODEL=gemini-3.8-flash

# Optional: Gemini failover timing budgets (milliseconds)
# GEMINI_REQUEST_TIMEOUT_MS=12000
# GEMINI_OVERALL_DEADLINE_MS=28000
# GEMINI_RETRY_DELAY_MS=150

# --- GitHub API Configuration ---
# Optional: GitHub Personal Access Token to raise GitHub API rate limits
# GITHUB_TOKEN=your_github_token_here

# --- Server & Request Payload Configuration ---
# Optional: Server Port (defaults to 5000)
# PORT=5000

# Optional: JSON request body limits (default global limit is 256kb; AI/memory routes allow 1mb)
# JSON_BODY_LIMIT=256kb
# AI_BODY_LIMIT=1mb

# Optional: Token required in `x-health-token` header for /api/health/graph when set
# HEALTH_CHECK_TOKEN=

# --- Graph Database Provider Configuration ---
# Canonical graph database provider: 'falkordb'
GRAPH_DATABASE_PROVIDER=falkordb

# --- FalkorDB Configuration ---
# Graph name to isolate repository knowledge (defaults to: traceforge)
FALKORDB_GRAPH=traceforge

# Option A: Full Connection URL (Recommended for Vercel / Cloud deployments)
# Supports falkors://, falkor://, rediss://, or redis:// with credentials:
# Example: falkors://default:your_password@your-subdomain.falkordb.cloud:6379
# FALKORDB_URL=

# Option B: Individual Connection Parameters
# Local Docker setup: FALKORDB_HOST=localhost, FALKORDB_PORT=6379
# FalkorDB Cloud: FALKORDB_HOST=your-subdomain.falkordb.cloud, FALKORDB_PORT=6379, FALKORDB_PASSWORD=your_password
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
# FALKORDB_PASSWORD=
# FALKORDB_USERNAME=default
# FALKORDB_CONNECT_TIMEOUT_MS=10000
